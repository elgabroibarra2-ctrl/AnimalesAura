@{
    ViewData["Title"] = "Proceso de adopción";
}

<section>
    <span>UN PROCESO CON CARIÑO</span>
    <h1>¿Cómo empieza una adopción?</h1>
    <p>
        Adoptar es una decisión para toda la vida.
        Tómate el tiempo de conocer y preparar a tu familia.
    </p>
</section>

<section>
    <article>
        <span>01</span>
        <h2>Conoce</h2>
        <p>
            Explora los perfiles y piensa qué compañero
            se adapta a tu hogar, tus tiempos y tu estilo de vida.
        </p>
    </article>

    <article>
        <span>02</span>
        <h2>Platiquemos</h2>
        <p>
            Cuéntanos un poco de ti. El refugio puede
            resolver tus dudas y explicarte los requisitos.
        </p>
    </article>

    <article>
        <span>03</span>
        <h2>Prepara su llegada</h2>
        <p>
            Organiza un espacio seguro, alimento,
            cuidados veterinarios y mucho tiempo
            para acompañarlo.
        </p>
    </article>
</section>

<a asp-controller="Home" asp-action="Animales">Conocer animales</a>